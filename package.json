{
  "name": "salary-clock",
  "displayName": "哄我上班 - 薪资时钟",
  "description": "在状态栏实时展示今日工资，每一秒都在变富 💰",
  "version": "1.0.0",
  "publisher": "XiaoZ-0218",
  "license": "MIT",
  "icon": "img/icon-192.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/XiaoZ-0218/salary-clock"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "salary",
    "clock",
    "工资",
    "计时",
    "状态栏"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "files": [
    "out",
    "img",
    "web"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "salaryClock.showSettings",
        "title": "薪资时钟: 打开扩展设置",
        "icon": "$(gear)"
      },
      {
        "command": "salaryClock.toggleDisplay",
        "title": "薪资时钟: 切换状态栏显示",
        "icon": "$(eye)"
      },
      {
        "command": "salaryClock.openClock",
        "title": "薪资时钟: 打开时钟面板",
        "icon": "$(watch)"
      },
      {
        "command": "salaryClock.debug",
        "title": "薪资时钟: 输出调试信息",
        "icon": "$(debug)"
      },
      {
        "command": "salaryClock.addWorkday",
        "title": "薪资时钟: 添加调休",
        "icon": "$(plus)"
      },
      {
        "command": "salaryClock.removeWorkday",
        "title": "薪资时钟: 删除调休",
        "icon": "$(trash)"
      }
    ],
    "keybindings": [
      {
        "command": "salaryClock.openClock",
        "key": "alt+shift+d",
        "mac": "alt+shift+d",
        "when": "true"
      }
    ],
    "configuration": {
      "title": "薪资时钟",
      "properties": {
        "salaryClock.monthlySalary": {
          "type": "number",
          "default": 20000,
          "description": "月薪（元）"
        },
        "salaryClock.startTime": {
          "type": "string",
          "default": "09:00",
          "description": "上班时间 (HH:mm)"
        },
        "salaryClock.endTime": {
          "type": "string",
          "default": "18:00",
          "description": "下班时间 (HH:mm)"
        },
        "salaryClock.lunchDurationMin": {
          "type": "number",
          "default": 60,
          "description": "午休时长（分钟），0 表示无午休"
        },
        "salaryClock.lunchStart": {
          "type": "string",
          "default": "12:00",
          "description": "午休开始时间 (HH:mm)"
        },
        "salaryClock.mode": {
          "type": "string",
          "enum": [
            "work",
            "always"
          ],
          "default": "work",
          "description": "计算模式：work = 上班才赚钱，always = 随时都赚钱"
        },
        "salaryClock.decimalPlaces": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "maximum": 6,
          "description": "显示的小数位数"
        },
        "salaryClock.updateIntervalMs": {
          "type": "number",
          "default": 250,
          "minimum": 50,
          "maximum": 1000,
          "description": "刷新间隔（毫秒），越小跳动越快（250 在 4 位小数下兼顾顺滑与可读）"
        },
        "salaryClock.showIcon": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示 💰 图标"
        },
        "salaryClock.workdayAdjustment": {
          "type": "boolean",
          "default": true,
          "description": "是否启用调休上班日（默认 true，按内置 + 用户配置的调休表把周末改成工作日；设为 false 时调休按休息日处理，适合外企/弹性工作制）"
        },
        "salaryClock.workdays": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "日期，格式 YYYY-MM-DD"
              },
              "name": {
                "type": "string",
                "description": "调休名称"
              }
            },
            "required": ["date", "name"],
            "additionalProperties": false
          },
          "default": [],
          "description": "调休上班日（增量合并到内置数据）。格式：[{date:'YYYY-MM-DD', name:'调休名'}]。同一天同时出现在节假日和调休中时，节假日优先。"
        },
        "salaryClock.theme": {
          "type": "string",
          "enum": [
            "aurora",
            "cyber",
            "warm",
            "ocean",
            "mono",
            "forest",
            "ledger",
            "arcade"
          ],
          "enumDescriptions": [
            "极光舞台",
            "霓虹终端",
            "樱桃汽水",
            "深海声呐",
            "黑白杂志",
            "松林晨雾",
            "黑金账本",
            "像素街机"
          ],
          "default": "aurora",
          "description": "时钟面板主题样式"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext .ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "eslint": "^8.57.1",
    "@typescript-eslint/parser": "^7.18.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "tsx": "^4.19.2"
  }
}
